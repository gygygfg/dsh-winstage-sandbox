# P1-escalation-policy-denied — H1：never 档位下自动拒绝的升级被说成"用户拒绝了"
# target (相对 harness 根): node_modules/@deepseek-ai/dsh-sandbox/lib/index.js
# upstream: @deepseek-ai/dsh-sandbox@0.2.0-rc.2 (packages/sandbox/sandbox)
# status: verified
# rationale: approval:never 时 dsh-user-approval 直接返回 rejected（根本没问用户），dsh-sandbox 却把每个 rejected 都渲染成"用户拒绝"。
# 本文件由 tools/dsh-patches.mjs --emit-patches 从 patches/dsh/manifest.json 派生，请勿手工编辑。
# 应用方式（在 harness 根下）: git apply -p1 <本文件>  或  node tools\dsh-patches.mjs --apply
diff --git a/node_modules/@deepseek-ai/dsh-sandbox/lib/index.js b/node_modules/@deepseek-ai/dsh-sandbox/lib/index.js
index ffca630..8d6aac0 100644
--- a/node_modules/@deepseek-ai/dsh-sandbox/lib/index.js
+++ b/node_modules/@deepseek-ai/dsh-sandbox/lib/index.js
@@ -115,7 +115,24 @@ async function approveEscalation(request, approval) {
 	});
 	switch (outcome) {
 		case "allowed-once": return mode;
-		case "rejected": throw new Error(`the user rejected escalating this ${subject} to "${mode}"; it stays denied, so stop and explain instead of working around it`);
+		case "rejected": {
+			// H1: a "never" approval policy makes the approval service return "rejected"
+			// WITHOUT dispatching the waterfall (nobody was asked), so blaming the user is
+			// wrong. Attribute it to the session policy instead. Computing this message must
+			// never throw: a failure here would replace the denial with noise.
+			let policy;
+			try {
+				policy = approval.approver.effectivePolicy?.(approval.agent.session);
+			} catch {
+				policy = void 0;
+			}
+			if (policy === "never") {
+				const error = new Error(`sandbox escalation to "${mode}" is denied by this session's approval policy ("never"), so the ${subject} was not executed; approval prompts are disabled for this session — report the blocked step to the user instead of retrying with sandbox_permissions`);
+				error.code = "ESCALATION_POLICY_DENIED";
+				throw error;
+			}
+			throw new Error(`the user rejected escalating this ${subject} to "${mode}"; it stays denied, so stop and explain instead of working around it`);
+		}
 		case "cancelled": throw new Error(`approval for escalating to "${mode}" was cancelled`);
 		case "unavailable": throw new Error(`sandbox escalation to "${mode}" requires approval, but no approval channel is available`);
 		default: return assertNever(outcome, "EscalationOutcome");
