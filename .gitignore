# ══════════════════════════════════════════════════════════════════════════════
# WinStageSandbox 忽略规则
#
# 设计原则：**测试套件入库，测试产物不入库**。
#
#   1) 套件入库。`tests/*.mjs` 与它依赖的源码（`src/`、`dsh-plugin/`、`tools/*.mjs`、
#      `patches/`）一律纳入版本库。此前 `tests/` 被整目录忽略、`tools/` 与部分 `src/`
#      从未入版本库，于是"这个文件没被动过"在 `git status` 里**看不见**
#      （见 tools/baseline-sha256.mjs 与 tests/baseline-integrity.mjs）。
#      ★ 因此**不要再把 `tests/` 加回忽略**：那会让整套测试重新变成
#        "无副本、漂移不可见"的状态，而这正是源码封印套件要钉死的事。
#
#   2) 产物不入库，理由三条：
#        · 体积：单次运行会产生几十到上百个日志/报告文件；
#        · 噪音：每次运行的输出都会变，入库只会造成无意义的 diff；
#        · 安全：`.t/` 下的沙箱暂存区会被 ACL 后端施加**长期存在的 Low 完整性标签**
#          与能力 SID 授予（见 docs/Windows功能开启清单.md 残余边界 R5），
#          里面的内容既含宿主路径，也带着安全描述符残留 —— 不该进版本库。
# ══════════════════════════════════════════════════════════════════════════════

# ── 测试运行时目录（本项目的所有测试产物都在这里）─────────────────────────────
# 包含：run-*.txt / run-audit.json / test-report.json / selftest-report.json
#       以及各次运行创建的一次性工作区（ws/、diagstage/、e2e-flow/、probe/ …）
.t/

# 兼容：直接用项目根作为工作区时，暂存区会落在根下
.dshstage/

# ── 测试工作区与报告（若被显式放到别处）─────────────────────────────────────────
# 套件本身（tests/*.mjs）**入库**；只有运行产物不入库。
test-report*.json
selftest-report*.json
run-*.txt
run-*.json
*.audit.json

# ── 未入库的工程树：构建产物 / 采购的工具链 / 一次性探针现场 ──────────────────────
# `shim/`：shim 与注入器是**构建产物树**（含 21 MB 中间件与证据）；套件在 DLL 缺失时
#   按设计 skip 并打印 `node tools/build-shim.mjs`；源码封印也把 `shim/` 排除在外。
shim/
# 采购的 zig 工具链（467 MB）；由 `node tools/fetch-toolchain.mjs` 重建
tools/toolchain/
tools/_probe-chan2.txt
# 历史探针/重跑现场（与下方 `esc/`、`filemod/` 同类：留在磁盘，仅不入库）
.lead/
_sandbox-tests/
_r3/
retest/
_gprobe2.txt

# ── 可再生缓存（体积最大，删除后由测试自动重建）──────────────────────────────────
# Edge/Chromium 测试 profile：跑一次浏览器测试就生成 ~1.3 GB 缓存，与项目内容无关。
# 即使 `.t/` 已被整体忽略，这里仍显式声明 —— 防止路径/大小写变体漏网。
.t/dsh2/browser/edge-profile/
.t/dsh2/browser/edge-profile-test/
**/edge-profile/
**/edge-profile-test/
**/component_crx_cache/
**/ProvenanceData/

# ── 历史运行的大体积产物 ────────────────────────────────────────────────────────
# 上一轮 sbx3 实例的沙箱测试夹具与命令队列产物（可再生；删除前已核对文档引用）
.t/sbx3/t-exe/
.t/sbx3/queue/

# ── 测试期导入的依赖缓存 ────────────────────────────────────────────────────────
npminstall/

# ── 历史探针/试验的散落产物（保持在磁盘上，但不入库）────────────────────────────
# 这些是 past 运行留下的目录与根下临时文件；保留以免误删数据，仅从版本库排除。
#
# ★ `esc/` 与 `filemod/` 同时是**被引用的证据**：
#     `esc\filemod_report.txt`   = 第 1 轮完整输出（17 项）
#     `filemod\bin.dat`          = 1 MiB 二进制往返样本
#     `filemod\test_filemod.ps1` = 测试脚本
#   已提交文档（实测证据记录.md、file-modification-test-report.md）以表格引用它们，
#   因此**文件必须留在磁盘上**；这里只保证它们不进版本库。
esc/
filemod/
sub/
# `.recon/`：一次性写入探针现场（如 probe-write-tool.txt），无文档引用，不入库
.recon/
probe2.txt
SANDBOX_TEST_write_probe.md
sandbox-test-report.md

# ── 临时/诊断输出 ──────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
~$*

# ── 依赖与构建 ────────────────────────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# 本地包管理器缓存/存储（脚本偶尔在仓库内产生）
.npmcache/
.pnpm-store/
.npm/

# ── 编辑器与工具 ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── 操作系统 ──────────────────────────────────────────────────────────────────
# Windows 快捷方式与缩略图缓存
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Thin-provisioned / 稀疏文件与卷影副本残留
*.vhd
*.vhdx
*.avhdx

# ── 凭据与机秘（绝不入库）──────────────────────────────────────────────────────
# 测试服务会打印随机令牌；若有人把它写进文件，必须被挡住
*.token
token.txt
.env
.env.*
!.env.example
# DSH 自身的凭据与会话数据（见 tools.mjs 的 MASK_CLASSES）
.dsh/
credentials.json
